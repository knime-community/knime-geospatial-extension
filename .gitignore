# Byte-compiled / optimized / DLL files
__pycache__/

#Users personal config files based on the config.yml file e.g. config_tobi.yml
config_*.yml
.vscode/*
tests/test.html
tests/test.ipynb
tests/*.ipynb

# pixi environments
.pixi
*.egg-info
local-update-site

# `pixi run build dest=<path>` (matching the older doc syntax) doesn't strip the "dest=" prefix with this pixi
# version - it lands the literal string as the output path, creating a bogus nested "dest=/abs/path/..." tree
# inside knime_extension/ instead of writing to <path>. Ignored as a safety net; the actual fix is calling
# `pixi run build <path>` (positional, no "dest=" prefix).
knime_extension/dest=*

# Java/Maven-Tycho build output
target/
.flattened-pom.xml

# Tycho's pomless/manifest-first mode auto-derives a synthetic pom into one of these per module without its own
# pom.xml, rewriting it on every build - every module here now has a real committed pom.xml instead, so these are
# stale generated cache, not source.
.polyglot.*

# .mvn/extensions.xml activated Tycho's pomless mode above; no longer used now that every module has a real pom.xml.
.mvn/

# Third-party jars for org.knime.geospatial.io are resolved via Ivy (ivy.xml) at build time, not vendored in git -
# see build.xml's "main" target, wired into the Maven build via the maven-antrun-plugin execution in pom.xml.
org.knime.geospatial.io/lib/*.jar
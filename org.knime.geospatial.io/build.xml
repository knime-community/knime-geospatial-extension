<project xmlns:ivy="antlib:org.apache.ivy.ant" name="geospatial-io-deps" default="main">

    <target name="lib-resolve" description="resolve the jars declared in ivy.xml">
        <ivy:settings file="ivysettings.xml"/>
        <ivy:resolve file="ivy.xml" conf="default"/>
    </target>

    <target name="clean-plugin-lib" description="remove previously vendored jars so stale/removed deps don't linger">
        <delete includeemptydirs="true">
            <fileset dir="lib" includes="**/*.jar"/>
        </delete>
    </target>

    <target name="copy-deps" depends="lib-resolve,clean-plugin-lib"
        description="copy the resolved runtime jars into lib/">
        <!-- type must cover both plain jars and OSGi-bundle-packaged artifacts (<packaging>bundle</packaging> in
             the POM, e.g. jts-core/indriya/snappy-java/json-simple) - both are physically .jar files, Ivy just
             tags them differently based on Maven packaging. -->
        <ivy:cachefileset setid="runtime.jars" conf="default" type="jar,bundle"/>
        <restrict id="runtime.filtered">
            <fileset refid="runtime.jars"/>
            <not>
                <or>
                    <name name="**/*-sources.jar"/>
                    <name name="**/*-javadoc.jar"/>
                    <name name="**/*-tests.jar"/>
                </or>
            </not>
        </restrict>
        <mkdir dir="lib"/>
        <copy todir="lib" overwrite="false" flatten="true">
            <resources refid="runtime.filtered"/>
        </copy>
    </target>

    <target name="update-bundle-classpath" depends="copy-deps"
        description="regenerate MANIFEST.MF's Bundle-ClassPath from whatever jars actually ended up in lib/">
        <path id="runtime.libs">
            <fileset dir="lib" includes="**/*.jar"/>
        </path>
        <pathconvert property="bundle.classpath.libs" refid="runtime.libs" pathsep=",">
            <mapper>
                <chainedmapper>
                    <flattenmapper/>
                    <globmapper from="*" to="lib/*"/>
                </chainedmapper>
            </mapper>
        </pathconvert>
        <property name="bundle.classpath" value=".,${bundle.classpath.libs}"/>
        <echo message="Bundle-ClassPath will be: ${bundle.classpath}"/>
        <manifest file="META-INF/MANIFEST.MF" mode="update">
            <attribute name="Bundle-ClassPath" value="${bundle.classpath}"/>
        </manifest>
    </target>

    <target name="update-classpath-file" depends="copy-deps"
        description="regenerate .classpath's kind=lib entries from whatever jars actually ended up in lib/ -
            no IvyDE (or any other Eclipse Ivy plugin) required, the IDE just sees plain jar classpath entries.">
        <path id="runtime.libs.cp">
            <fileset dir="lib" includes="**/*.jar"/>
        </path>
        <pathconvert property="classpath.lib.entries" refid="runtime.libs.cp" pathsep="${line.separator}">
            <mapper type="regexp" from="^.*[/\\]([^/\\]+\.jar)$$"
                to="	&lt;classpathentry exported=&quot;true&quot; kind=&quot;lib&quot; path=&quot;lib/\1&quot;/&gt;"/>
        </pathconvert>
        <echo file=".classpath"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>
	<classpathentry exported="true" kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" path="src"/>
]]></echo>
        <echo file=".classpath" append="true">${classpath.lib.entries}${line.separator}</echo>
        <echo file=".classpath" append="true"><![CDATA[	<classpathentry kind="output" path="bin"/>
</classpath>
]]></echo>
    </target>

    <target name="main" depends="copy-deps,update-bundle-classpath,update-classpath-file"/>

</project>
